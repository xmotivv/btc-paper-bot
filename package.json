{
  "name": "btc-paper-bot",
  "productName": "BTC Paper Bot",
  "version": "0.1.0",
  "description": "Paper-trading bot for Polymarket Bitcoin Up/Down markets",
  "main": "src/main.js",
  "author": "The Clubhouse Golf Studio",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/OWNER/REPO.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --publish never",
    "release:patch": "npm version patch && git push --follow-tags",
    "release:minor": "npm version minor && git push --follow-tags"
  },
  "dependencies": {
    "electron-log": "^5.4.0",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.clubhouse.btcpaperbot",
    "productName": "BTC Paper Bot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "BTC-Paper-Bot-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BTC Paper Bot"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "REPO",
        "releaseType": "release"
      }
    ]
  }
}
